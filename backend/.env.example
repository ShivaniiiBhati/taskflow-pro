# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite file, created automatically on first run)
DATABASE_URL=sqlite:///./taskflow.db

# AI provider used for the dependency-suggestion feature.
# If ANTHROPIC_API_KEY is left blank, the app automatically runs in
# MOCK mode: it still returns a suggestion (the single most similar
# candidate task by local text similarity) so the app is fully demoable
# offline / without a key. See app/services/dependency_ai.py.
ANTHROPIC_API_KEY=your_api_key_here
AI_MODEL=claude-sonnet-5

# Shared bearer token the frontend must send as `Authorization: Bearer <token>`.
# Not a real multi-user login system -- see README Security section --
# but keeps the API from sitting open to the public internet.
# CHANGE THIS before any real deployment.
API_TOKEN=dev-local-token

# CORS origin for the local Vite dev server
FRONTEND_ORIGIN=http://localhost:5173
